            if string.find(lower, "main") or string.find(lower, "info") or string.find(lower, "general") then
                TabIcon = "rbxassetid://10723415903" -- ⓘ info
            elseif string.find(lower, "home") then
                TabIcon = "rbxassetid://10723356507" -- 🏠 home
            elseif string.find(lower, "farm") then
                TabIcon = "rbxassetid://10734975692" -- ⚔ swords
