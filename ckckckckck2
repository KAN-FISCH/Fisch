                    if TogObj.Locked then return end
                    TogObj.Value = val
                    local targetPos = val and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
                    local targetBg = val and Custom.AccentColor or Color3.fromRGB(26, 32, 46)
