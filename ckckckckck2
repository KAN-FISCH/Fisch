    end

    -- Periodic Memory Cleanup for Anti-lag during long AFK
    task.spawn(function()
        while task.wait(180) do
            pcall(collectgarbage, "collect")
        end
    end)

    function Tabs:SetVisible(vis)
        DropShadowHolder.Visible = vis
        if vis then
            DropShadowHolder.Size = UDim2.fromOffset(BaseWidth * 0.9, BaseHeight * 0.9)
            TweenService:Create(DropShadowHolder, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
