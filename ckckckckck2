                local function FormatSelected()
                    if Multi then
                        if #DropObj.Value == 0 then return "None" end
                        return table.concat(DropObj.Value, ", ")
                    else
                        return tostring(DropObj.Value[1] or "None")
                    end
                end

                local function CalcScrollDimensions(count)
                    count = count or 0
                    local itemH = 26
                    local itemPad = 4
                    local maxVisible = 4
                    local scrollH = 0
                    if count <= 0 then
                        scrollH = 24
                    elseif count <= maxVisible then
                        scrollH = (count * (itemH + itemPad)) - itemPad
                    else
                        scrollH = math.floor(maxVisible * (itemH + itemPad) + (itemH * 0.35))
                    end
                    local totalCardH = 38 + 28 + scrollH + 10
                    return scrollH, totalCardH
                end

                local function UpdateVisualHeights(animate)
                    if not DropObj.IsOpen then return end
                    local q = string.lower(DropSearchInput.Text)
                    local visibleCount = 0
                    for _, child in ipairs(OptionsScroll:GetChildren()) do
                        if child:IsA("Frame") and child.Name:sub(1, 4) == "Opt_" then
                            local optName = child:GetAttribute("OptionName") or ""
                            local show = (q == "") or (string.find(string.lower(optName), q, 1, true) ~= nil)
                            child.Visible = show
                            if show then
                                visibleCount = visibleCount + 1
                            end
                        end
                    end

                    local noResultLbl = OptionsScroll:FindFirstChild("NoResults")
                    if visibleCount == 0 and q ~= "" then
                        if not noResultLbl then
                            noResultLbl = Custom:Create("TextLabel", {
                                Font = Enum.Font.Gotham,
                                Text = "No options found",
                                TextColor3 = Color3.fromRGB(140, 140, 150),
                                TextSize = 11,
                                TextXAlignment = Enum.TextXAlignment.Center,
                                BackgroundTransparency = 1,
                                Size = UDim2.new(1, 0, 0, 24),
                                ZIndex = 7,
                                Name = "NoResults",
                                Parent = OptionsScroll
                            })
                        else
                            noResultLbl.Visible = true
                        end
                    elseif noResultLbl then
                        noResultLbl.Visible = false
                    end

                    local scrollH, totalCardH = CalcScrollDimensions(visibleCount)
                    OptionsScroll.Size = UDim2.new(1, 0, 0, scrollH)
                    OptionsListFrame.Size = UDim2.new(1, -20, 0, 28 + scrollH)

                    if animate then
                        TweenService:Create(DropCard, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.new(1, 0, 0, totalCardH)
                        }):Play()
                    else
                        DropCard.Size = UDim2.new(1, 0, 0, totalCardH)
                    end
                end

                local function RebuildOptions()
                    for _, child in ipairs(OptionsScroll:GetChildren()) do
                        if child:IsA("Frame") and child.Name:sub(1, 4) == "Opt_" then
                            child:Destroy()
                        elseif child:IsA("TextLabel") and child.Name == "NoResults" then
                            child:Destroy()
                        end
                    end

                    for idx, opt in ipairs(DropObj.Options) do
                        local optStr = tostring(opt)
                        local isSelected = table.find(DropObj.Value, opt) ~= nil
                        local optBox = Custom:Create("Frame", {
                            BackgroundColor3 = isSelected and Color3.fromRGB(24, 32, 48) or Color3.fromRGB(16, 20, 30),
                            BorderSizePixel = 0,
                            Size = UDim2.new(1, -4, 0, 26),
                            ZIndex = 7,
                            LayoutOrder = idx,
                            Name = "Opt_" .. optStr,
                            Parent = OptionsScroll
                        })
                        optBox:SetAttribute("OptionName", optStr)

                        Custom:Create("UICorner", {
                            CornerRadius = UDim.new(0, 4),
                            Parent = optBox
                        })

                        local optStroke = Custom:Create("UIStroke", {
                            Color = isSelected and Color3.fromRGB(0, 195, 255) or Color3.fromRGB(28, 36, 50),
                            Thickness = 1,
                            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                            Parent = optBox
                        })

                        local optLbl = Custom:Create("TextLabel", {
                            Font = Enum.Font.Gotham,
                            Text = "   " .. optStr,
                            TextColor3 = isSelected and Custom.AccentBright or Color3.fromRGB(200, 215, 235),
                            TextSize = 11,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            BackgroundTransparency = 1,
                            Size = UDim2.new(1, 0, 1, 0),
                            ZIndex = 8,
                            Parent = optBox
                        })

                        local optBtn = Custom:Create("TextButton", {
                            Text = "",
                            BackgroundTransparency = 1,
                            Size = UDim2.new(1, 0, 1, 0),
                            ZIndex = 9,
                            Parent = optBox
                        })

                        optBtn.MouseEnter:Connect(function()
                            optBox.BackgroundColor3 = Color3.fromRGB(28, 38, 56)
                        end)
                        optBtn.MouseLeave:Connect(function()
                            local stillSelected = table.find(DropObj.Value, opt) ~= nil
                            optBox.BackgroundColor3 = stillSelected and Color3.fromRGB(24, 32, 48) or Color3.fromRGB(16, 20, 30)
                        end)

                        optBtn.Activated:Connect(function()
                            if DropObj.Locked then return end
                            if Multi then
                                local found = table.find(DropObj.Value, opt)
                                if found then
                                    table.remove(DropObj.Value, found)
                                else
                                    table.insert(DropObj.Value, opt)
                                end
                                SelectedText.Text = FormatSelected()
                                pcall(Callback, DropObj.Value)
                                RebuildOptions()
                                if DropObj.IsOpen then
                                    UpdateVisualHeights(false)
                                end
                            else
                                DropObj.Value = {opt}
                                SelectedText.Text = optStr
                                pcall(Callback, opt)
                                -- Auto close dropdown on single select
                                DropObj.IsOpen = false
                                Chevron.Text = "v"
                                DropSearchInput.Text = ""
                                local closeTw = TweenService:Create(DropCard, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                    Size = UDim2.new(1, 0, 0, 36)
                                })
                                closeTw:Play()
                                closeTw.Completed:Connect(function()
                                    if not DropObj.IsOpen then
                                        OptionsListFrame.Visible = false
                                        OptionsListFrame.Size = UDim2.new(1, -20, 0, 0)
                                    end
                                end)
                            end
                        end)
                    end
                end

                RebuildOptions()

                DropSearchInput:GetPropertyChangedSignal("Text"):Connect(function()
                    if DropObj.IsOpen then
                        UpdateVisualHeights(true)
                    end
                end)

                DropdownToggleBtn.Activated:Connect(function()
                    if DropObj.Locked then return end
                    DropObj.IsOpen = not DropObj.IsOpen
                    Chevron.Text = DropObj.IsOpen and "^" or "v"

                    if DropObj.IsOpen then
                        OptionsListFrame.Visible = true
                        DropSearchInput.Text = ""
                        UpdateVisualHeights(true)
                    else
                        local closeTw = TweenService:Create(DropCard, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            Size = UDim2.new(1, 0, 0, 36)
                        })
                        closeTw:Play()
                        closeTw.Completed:Connect(function()
                            if not DropObj.IsOpen then
                                OptionsListFrame.Visible = false
                                OptionsListFrame.Size = UDim2.new(1, -20, 0, 0)
                                DropSearchInput.Text = ""
                            end
                        end)
                    end
                end)

                function DropObj:Set(newVal)
                    if type(newVal) == "table" then
                        self.Value = newVal
                    else
                        self.Value = {newVal}
                    end
                    SelectedText.Text = FormatSelected()
                    RebuildOptions()
                    if self.IsOpen then
                        UpdateVisualHeights(false)
                    end
                    pcall(Callback, Multi and self.Value or (self.Value[1]))
                end

                function DropObj:SetValue(v)
                    self:Set(v)
                end

                function DropObj:Refresh(newOptions, newSelect)
                    self.Options = newOptions or {}
                    if newSelect then
                        self:Set(newSelect)
                    else
                        RebuildOptions()
                        if self.IsOpen then
                            UpdateVisualHeights(false)
                        end
                    end
                end

                function DropObj:Lock()
                    self.Locked = true
                end

                function DropObj:Unlock()
                    self.Locked = false
                end

                return DropObj
            end

