                    Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(0.5, 0, 1, 0),
                    ZIndex = 4,
                    Parent = KeyCard
                })

                local BindHolder, BindData = Custom:CreateComponentCard({
                    Parent = KeyCard,
                    Size = UDim2.new(0, 90, 0, 24),
                    Position = UDim2.new(1, -10, 0.5, 0),
                    AnchorPoint = Vector2.new(1, 0.5),
                    CornerRadius = 4,
                    FillColor = Color3.fromRGB(16, 20, 32),
                    StrokeColor = Color3.fromRGB(0, 195, 255),
                    StrokeThickness = 1,
                    ZIndex = 5,
                    Name = "BindHolder"
                })

                local BindBtn = Custom:Create("TextButton", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Font = Enum.Font.GothamBold,
                    Text = KeyDefault.Name or "None",
                    TextColor3 = Custom.AccentGlow,
                    TextSize = 11,
                    ZIndex = 6,
                    Parent = BindHolder
                })

                local currentKey = KeyDefault
                local listening = false

                BindBtn.Activated:Connect(function()
                    if listening then return end
                    listening = true
                    BindBtn.Text = "..."
                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            currentKey = input.KeyCode
                            BindBtn.Text = currentKey.Name
                            listening = false
                            conn:Disconnect()
                            pcall(Callback, currentKey)
                        end
                    end)
                end)

                UserInputService.InputBegan:Connect(function(input, gpe)
                    if not gpe and input.KeyCode == currentKey then
                        pcall(Callback, currentKey)
                    end
                end)

                return { Value = currentKey }
            end

            function Section:Lock()
                self.Locked = true
            end

            function Section:Unlock()
                self.Locked = false
            end

            return Section
        end

        return TabObj
    end

