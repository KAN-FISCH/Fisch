                    TweenService:Create(Knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = targetPos, BackgroundColor3 = targetKnob}):Play()
                    pcall(Callback, val)
                    if TogObj.OnChangedFn then pcall(TogObj.OnChangedFn, val) end
