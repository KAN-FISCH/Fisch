            }):Play()
            Main.BackgroundTransparency = 1
            if MainCardData and MainCardData.SetFillTransparency then
                MainCardData.SetFillTransparency(0, 0)
                MainCardData.SetStrokeTransparency(0, 0)
            end
        end
    end

    function Tabs:Toggle()
        Tabs:SetVisible(not DropShadowHolder.Visible)
    end

    function Tabs:OpenROGLauncher(rogConfig)
        rogConfig = rogConfig or {}
        rogConfig.OnLaunch = rogConfig.OnLaunch or function()
            Tabs:SetVisible(true)
        end
        return Speed_Library:CreateROGLauncher(rogConfig)
    end

    return Tabs
end

