local Speed_Library = { Unloaded = false }
local GlobalNotificationGui = nil
local GlobalNotificationLayout = nil

function Speed_Library:SetNotification(Config)
    local Title = Config[1] or Config.Title or "Notification"
    local Description = Config[2] or Config.Description or ""
    local Content = Config[3] or Config.Content or ""
    local Delay = Config[6] or Config.Delay or 4

    if not GlobalNotificationGui or not GlobalNotificationGui.Parent then
        GlobalNotificationGui = Custom:Create("ScreenGui", {
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            Name = "QuantumNotificationGui"
        }, RunService:IsStudio() and Player.PlayerGui or (gethui and gethui() or game:GetService("CoreGui")))
        ProtectGui(GlobalNotificationGui)

        GlobalNotificationLayout = Custom:Create("Frame", {
            AnchorPoint = Vector2.new(1, 1),
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -20, 1, -20),
            Size = UDim2.new(0, 300, 1, 0),
            Name = "NotificationLayout"
        }, GlobalNotificationGui)

        local Count = 0
        GlobalNotificationLayout.ChildRemoved:Connect(function()
            Count = 0
            for _, v in ipairs(GlobalNotificationLayout:GetChildren()) do
                local newPos = UDim2.new(0, 0, 1, -((v.Size.Y.Offset + 8) * Count))
                TweenService:Create(v, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Position = newPos}):Play()
                Count = Count + 1
            end
        end)
    end

    local countOffset = 0
    for _, v in ipairs(GlobalNotificationLayout:GetChildren()) do
        countOffset = -(v.Position.Y.Offset) + v.Size.Y.Offset + 8
    end

    local NotifFrame = Custom:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(15, 14, 20),
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 65),
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 350, 1, -countOffset),
        Name = "NotifFrame"
    }, GlobalNotificationLayout)

    Custom:Create("UICorner", { CornerRadius = UDim.new(0, 8) }, NotifFrame)
    Custom:Create("UIStroke", { Color = Color3.fromRGB(255, 45, 75), Thickness = 1, Transparency = 0.4 }, NotifFrame)

    Custom:Create("TextLabel", {
        Font = Enum.Font.GothamBold,
        Text = Title,
        TextColor3 = Color3.fromRGB(245, 245, 250),
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 8),
        Size = UDim2.new(1, -24, 0, 16),
        Parent = NotifFrame
    })

    Custom:Create("TextLabel", {
        Font = Enum.Font.Gotham,
        Text = Content ~= "" and Content or Description,
        TextColor3 = Color3.fromRGB(160, 170, 190),
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 28),
        Size = UDim2.new(1, -24, 0, 30),
        Parent = NotifFrame
    })

    TweenService:Create(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 1, -countOffset)
    }):Play()

    task.delay(Delay, function()
        pcall(function()
            if NotifFrame and NotifFrame.Parent then
                local hide = TweenService:Create(NotifFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Position = UDim2.new(0, 350, 1, NotifFrame.Position.Y.Offset)
                })
                hide:Play()
                hide.Completed:Wait()
                NotifFrame:Destroy()
            end
        end)
    end)
end

