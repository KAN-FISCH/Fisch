        TweenService:Create(FlashSweep, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 120, 0.5, 0),
            BackgroundTransparency = 1
        }):Play()

        -- 5 Seconds Wait Period after Selection with Live Countdown & Tap to Skip
        local skipWait = false
        local skipConn = SkipClickArea.Activated:Connect(function()
            skipWait = true
        end)

        for remaining = 5, 1, -1 do
            if skipWait then break end
            StatusSub.Text = string.format("LAUNCHING FISCH ROG EDITION IN %ds...", remaining)
            SkipHint.Text = string.format("Starting game in %ds • Tap anywhere to skip", remaining)
            local t = 0
            while t < 1 and not skipWait do
                task.wait(0.05)
                t = t + 0.05
            end
        end

        pcall(function() skipConn:Disconnect() end)
        StatusSub.Text = "LAUNCHING FISCH ROG EDITION..."
        SkipHint.Text = ""

        -- 2. GACHA SCREEN FADE OUT ("screen nya memudar kek lagi gacha versi chart rog")
        TweenService:Create(FadeOverlay, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0
        }):Play()
        TweenService:Create(LauncherHolder, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(820, 460),
            Position = UDim2.new(0.5, 0, 0.48, 0)
        }):Play()

        task.wait(0.48)
        ROGGui:Destroy()
        OnLaunch(fischGame)
    end

    -- Skip on click anywhere
    SkipClickArea.Activated:Connect(TriggerFinishLaunch)

    CloseBtn.Activated:Connect(function()
        if isLaunched then return end
        isLaunched = true
        if rollTween then rollTween:Cancel() end
        TweenService:Create(LauncherHolder, TweenInfo.new(0.25), {Size = UDim2.new(0, 0, 0, 0)}):Play()
        task.wait(0.25)
        ROGGui:Destroy()
        OnClose()
    end)

    -- ─────────────────────────────────────────────────────────────
    -- START AUTOMATIC GACHA ROULETTE ROLL ANIMATION
    -- ─────────────────────────────────────────────────────────────
    task.spawn(function()
        task.wait(0.15)
        local reelWidth = ReelContainer.AbsoluteSize.X > 0 and ReelContainer.AbsoluteSize.X or 740
        local targetCenter = (winningIndex - 1) * stepX + (cardWidth / 2)
        local finalTargetX = (reelWidth / 2) - targetCenter

        -- Initial position with Card 1 or 2 in view
        local startX = (reelWidth / 2) - ((1 - 1) * stepX + (cardWidth / 2)) + 120
        ReelStrip.Position = UDim2.new(0, startX, 0.5, 0)

        -- Smooth easing roll (starts fast, slows down realistically, lands on Fisch)
        rollTween = TweenService:Create(ReelStrip, TweenInfo.new(2.4, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, finalTargetX, 0.5, 0)
        })
        rollTween:Play()

        rollTween.Completed:Connect(function()
            if not isLaunched then
                TriggerFinishLaunch()
            end
        end)
    end)

    local LauncherObj = {
        ScreenGui = ROGGui,
        Launch = TriggerFinishLaunch,
        Close = function()
            ROGGui:Destroy()
            OnClose()
        end
    }
    return LauncherObj
end

return Speed_Library
