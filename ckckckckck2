        TopMarker.BackgroundColor3 = Color3.fromRGB(0, 195, 255)
        BtmMarker.BackgroundColor3 = Color3.fromRGB(0, 195, 255)
        TweenService:Create(TopMarker, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true), {
            BackgroundColor3 = Color3.fromRGB(255, 45, 75)
        }):Play()
        TweenService:Create(BtmMarker, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true), {
            BackgroundColor3 = Color3.fromRGB(255, 45, 75)
        }):Play()

        -- CenterGlowBox expands and glows
        TweenService:Create(CenterGlowBox, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(188, 228),
            BackgroundTransparency = 0.55
        }):Play()
        centerStroke.Color = Color3.fromRGB(255, 45, 75)
        centerStroke.Transparency = 0

        -- TargetCard pop
        if TargetCardUI and TargetCardUI.Card then
            TweenService:Create(TargetCardUI.Card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(168, 208)
            }):Play()
        end

        -- Flash beam sweep across the card
        local FlashSweep = Custom:Create("Frame", {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.4,
            BorderSizePixel = 0,
            Rotation = 35,
            AnchorPoint = Vector2.new(0.5, 0.5),
