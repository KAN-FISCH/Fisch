    -- Precision ASUS ROG Chamfered Box Builder (45-degree Beveled Cut Corners)
    local function CreateChamferBox(parent, size, pos, anchor, chamfer, strokeColor, fillColor, slitColor, zIndex, topColor, bottomColor)
        local root, cardData = Custom:CreateChamferCard({
            Parent = parent,
            Size = size,
            Position = pos,
            AnchorPoint = anchor or Vector2.new(0, 0),
            Chamfer = chamfer or 6,
            StrokeColor = strokeColor,
            FillColor = fillColor,
            StrokeThickness = 1.2,
            ZIndex = zIndex or 2,
            Name = "ChamferBox"
        })

        if topColor and bottomColor then
            cardData.TL_Fill.BackgroundColor3 = topColor
            cardData.TR_Fill.BackgroundColor3 = topColor
            cardData.BL_Fill.BackgroundColor3 = bottomColor
            cardData.BR_Fill.BackgroundColor3 = bottomColor
        end

        -- Bottom Glowing Neon Slit (Signature ROG Slit)
        local slit = Custom:Create("Frame", {
            BackgroundColor3 = slitColor,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -1),
            Size = UDim2.new(0.6, 0, 0, 2.5),
            ZIndex = (zIndex or 2) + 3,
            Name = "Slit"
        }, root)
        Custom:Create("UICorner", { CornerRadius = UDim.new(1, 0) }, slit)

        return root, slit, cardData.CenterH, cardData.CenterV
    end

    -- Universal Draggable & Click Handler (Works smoothly for PC & Mobile)
    local function SetupButtonInteraction(btn, rootBox, slit, baseSize, hoverSize, strokeColor, slitColor, onClick)
        local dragStart = nil
        local startPos = nil
        local isDragging = false

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragStart = input.Position
                startPos = DockHolder.Position
                isDragging = false

                local changedConn, endedConn
                changedConn = UserInputService.InputChanged:Connect(function(moveInput)
                    if (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) and dragStart then
                        local delta = moveInput.Position - dragStart
                        if delta.Magnitude > 6 then
                            isDragging = true
                        end
                        if isDragging then
                            DockHolder.Position = UDim2.new(
                                startPos.X.Scale, startPos.X.Offset + delta.X,
                                startPos.Y.Scale, startPos.Y.Offset + delta.Y
                            )
                        end
                    end
                end)

                endedConn = UserInputService.InputEnded:Connect(function(endInput)
                    if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                        if changedConn then changedConn:Disconnect() changedConn = nil end
                        if endedConn then endedConn:Disconnect() endedConn = nil end
                        if not isDragging then
                            if onClick then onClick() end
                        end
                        dragStart = nil
                        isDragging = false
                    end
                end)
            end
        end)

        btn.MouseEnter:Connect(function()
            TweenService:Create(rootBox, TweenInfo.new(0.15), {Size = hoverSize}):Play()
            TweenService:Create(slit, TweenInfo.new(0.15), {Size = UDim2.new(0.85, 0, 0, 3.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        end)
