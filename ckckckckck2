    function Custom:Create(Name, Properties, Parent)
        local _instance = Instance.new(Name)
        for i, v in pairs(Properties) do
            _instance[i] = v
        end
        if Parent then
            _instance.Parent = Parent
        end
        return _instance
    end

    -- Precision ASUS ROG Chamfered Card Builder (45-degree Beveled Cut Corners)
    function Custom:CreateChamferCard(cfg)
        local parent = cfg.Parent
        local size = cfg.Size or UDim2.new(1, 0, 0, 36)
        local pos = cfg.Position or UDim2.new(0, 0, 0, 0)
        local anchor = cfg.AnchorPoint or Vector2.new(0, 0)
        local layoutOrder = cfg.LayoutOrder or 0
        local name = cfg.Name or "ChamferCard"
        local C = cfg.Chamfer or 6
        local strokeColor = cfg.StrokeColor or Custom.StrokeColor
        local fillColor = cfg.FillColor or Custom.CardDark
        local strokeThickness = cfg.StrokeThickness or 1
        local cornerThickness = cfg.CornerThickness or strokeThickness
        local cornerColor = cfg.CornerColor or cfg.CornerStrokeColor or strokeColor
        local cornerTransparency = cfg.CornerTransparency or 0
        local zIndex = cfg.ZIndex or 2
        local clips = cfg.ClipsDescendants or false

        -- Root container (transparent, holds fill, stroke, and card content)
        local root = Custom:Create("Frame", {
            BackgroundColor3 = fillColor or Custom.CardDark,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = size,
            Position = pos,
            AnchorPoint = anchor,
            LayoutOrder = layoutOrder,
            ClipsDescendants = clips,
            Name = name,
            ZIndex = zIndex
        }, parent)

        local fillFrames = {}
        local cornerSize = math.round(C * 1.41421356)

        -- 1. Center Horizontal Fill: spans full width from y=C to y=H-C
        local CenterH = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, C),
            Size = UDim2.new(1, 0, 1, -2 * C),
            ZIndex = zIndex,
            Name = "CenterH"
        }, root)
        table.insert(fillFrames, CenterH)

        -- 2. Center Vertical Fill: spans width from x=C to x=W-C, height full
        local CenterV = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BorderSizePixel = 0,
            Position = UDim2.new(0, C, 0, 0),
            Size = UDim2.new(1, -2 * C, 1, 0),
            ZIndex = zIndex,
            Name = "CenterV"
        }, root)
        table.insert(fillFrames, CenterV)

        -- 3. Four Corner Triangles (Strictly clipped containers with rotated 45-degree squares)
        -- Top-Left Corner
        local TL_Box = Custom:Create("Frame", {
            BackgroundColor3 = fillColor or Custom.CardDark,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0, C, 0, C),
            ClipsDescendants = true,
            ZIndex = zIndex,
            Name = "TL_Box"
        }, root)
        local TL_Fill = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(1, 0, 1, 0),
            Size = UDim2.new(0, cornerSize, 0, cornerSize),
            Rotation = 45,
            ZIndex = zIndex,
            Name = "TL_Fill"
        }, TL_Box)
        table.insert(fillFrames, TL_Fill)

        -- Top-Right Corner
        local TR_Box = Custom:Create("Frame", {
            BackgroundColor3 = fillColor or Custom.CardDark,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -C, 0, 0),
            Size = UDim2.new(0, C, 0, C),
            ClipsDescendants = true,
            ZIndex = zIndex,
            Name = "TR_Box"
        }, root)
        local TR_Fill = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(0, cornerSize, 0, cornerSize),
            Rotation = 45,
            ZIndex = zIndex,
            Name = "TR_Fill"
        }, TR_Box)
        table.insert(fillFrames, TR_Fill)

        -- Bottom-Left Corner
        local BL_Box = Custom:Create("Frame", {
            BackgroundColor3 = fillColor or Custom.CardDark,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 1, -C),
            Size = UDim2.new(0, C, 0, C),
            ClipsDescendants = true,
            ZIndex = zIndex,
            Name = "BL_Box"
        }, root)
        local BL_Fill = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.new(0, cornerSize, 0, cornerSize),
            Rotation = 45,
            ZIndex = zIndex,
            Name = "BL_Fill"
        }, BL_Box)
        table.insert(fillFrames, BL_Fill)

        -- Bottom-Right Corner
        local BR_Box = Custom:Create("Frame", {
            BackgroundColor3 = fillColor or Custom.CardDark,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -C, 1, -C),
            Size = UDim2.new(0, C, 0, C),
            ClipsDescendants = true,
            ZIndex = zIndex,
            Name = "BR_Box"
        }, root)
        local BR_Fill = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0, cornerSize, 0, cornerSize),
            Rotation = 45,
            ZIndex = zIndex,
            Name = "BR_Fill"
        }, BR_Box)
        table.insert(fillFrames, BR_Fill)

        -- 4. Perimeter Stroke Segments (8 segments: 4 straight edges + 4 diagonal corner cuts in ROG Red)
        local strokeLines = {}
        local cornerLines = {}
        if strokeThickness and strokeThickness > 0 and strokeColor then
            local strokeZ = zIndex + 1
            local cornerZ = strokeZ + 1

            local TopLine = Custom:Create("Frame", {
                BackgroundColor3 = strokeColor,
                BorderSizePixel = 0,
                Position = UDim2.new(0, C, 0, 0),
                Size = UDim2.new(1, -2 * C, 0, strokeThickness),
                ZIndex = strokeZ,
                Name = "TopLine"
            }, root)
            table.insert(strokeLines, TopLine)

            local BottomLine = Custom:Create("Frame", {
                BackgroundColor3 = strokeColor,
                BorderSizePixel = 0,
                Position = UDim2.new(0, C, 1, -strokeThickness),
                Size = UDim2.new(1, -2 * C, 0, strokeThickness),
                ZIndex = strokeZ,
                Name = "BottomLine"
            }, root)
            table.insert(strokeLines, BottomLine)

            local LeftLine = Custom:Create("Frame", {
                BackgroundColor3 = strokeColor,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0, C),
                Size = UDim2.new(0, strokeThickness, 1, -2 * C),
                ZIndex = strokeZ,
                Name = "LeftLine"
            }, root)
            table.insert(strokeLines, LeftLine)

            local RightLine = Custom:Create("Frame", {
                BackgroundColor3 = strokeColor,
                BorderSizePixel = 0,
                Position = UDim2.new(1, -strokeThickness, 0, C),
                Size = UDim2.new(0, strokeThickness, 1, -2 * C),
                ZIndex = strokeZ,
                Name = "RightLine"
            }, root)
            table.insert(strokeLines, RightLine)

            local diagLen = math.floor(C * 1.41421356)

            -- 4 High-Contrast ROG Corner Diagonal Cut Lines (Red by default so corners pop!)
            local TL_Diag = Custom:Create("Frame", {
                BackgroundColor3 = cornerColor,
                BackgroundTransparency = cornerTransparency,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, C / 2, 0, C / 2),
                Size = UDim2.new(0, diagLen, 0, cornerThickness),
                Rotation = -45,
                ZIndex = cornerZ,
                Name = "TL_Diag"
            }, root)
            table.insert(cornerLines, TL_Diag)

            local TR_Diag = Custom:Create("Frame", {
                BackgroundColor3 = cornerColor,
                BackgroundTransparency = cornerTransparency,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(1, -C / 2, 0, C / 2),
                Size = UDim2.new(0, diagLen, 0, cornerThickness),
                Rotation = 45,
                ZIndex = cornerZ,
                Name = "TR_Diag"
            }, root)
            table.insert(cornerLines, TR_Diag)

            local BL_Diag = Custom:Create("Frame", {
                BackgroundColor3 = cornerColor,
                BackgroundTransparency = cornerTransparency,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, C / 2, 1, -C / 2),
                Size = UDim2.new(0, diagLen, 0, cornerThickness),
                Rotation = 45,
                ZIndex = cornerZ,
                Name = "BL_Diag"
            }, root)
            table.insert(cornerLines, BL_Diag)

            local BR_Diag = Custom:Create("Frame", {
                BackgroundColor3 = cornerColor,
                BackgroundTransparency = cornerTransparency,
                BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(1, -C / 2, 1, -C / 2),
                Size = UDim2.new(0, diagLen, 0, cornerThickness),
                Rotation = -45,
                ZIndex = cornerZ,
                Name = "BR_Diag"
            }, root)
            table.insert(cornerLines, BR_Diag)
        end

        local cardData = {
            Root = root,
            CenterH = CenterH,
            CenterV = CenterV,
            TL_Fill = TL_Fill,
            TR_Fill = TR_Fill,
            BL_Fill = BL_Fill,
            BR_Fill = BR_Fill,
            FillFrames = fillFrames,
            StrokeLines = strokeLines,
            CornerLines = cornerLines,
            SetFillColor = function(col, dur)
                for _, f in ipairs(fillFrames) do
                    if dur and dur > 0 then
                        TweenService:Create(f, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = col}):Play()
                    else
                        f.BackgroundColor3 = col
                    end
                end
            end,
            SetStrokeColor = function(col, dur)
                for _, s in ipairs(strokeLines) do
                    if dur and dur > 0 then
                        TweenService:Create(s, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = col}):Play()
                    else
                        s.BackgroundColor3 = col
                    end
                end
            end,
            SetCornerColor = function(col, dur)
                for _, s in ipairs(cornerLines) do
                    if dur and dur > 0 then
                        TweenService:Create(s, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = col}):Play()
                    else
                        s.BackgroundColor3 = col
                    end
                end
            end,
            SetFillTransparency = function(trans, dur)
                for _, f in ipairs(fillFrames) do
                    if dur and dur > 0 then
                        TweenService:Create(f, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = trans}):Play()
                    else
                        f.BackgroundTransparency = trans
                    end
                end
            end,
            SetStrokeTransparency = function(trans, dur)
                for _, s in ipairs(strokeLines) do
                    if dur and dur > 0 then
                        TweenService:Create(s, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = trans}):Play()
                    else
                        s.BackgroundTransparency = trans
                    end
                end
                for _, s in ipairs(cornerLines) do
                    if dur and dur > 0 then
                        TweenService:Create(s, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = trans}):Play()
                    else
                        s.BackgroundTransparency = trans
                    end
                end
            end
        }

        root:SetAttribute("ChamferCard", true)
        return root, cardData
    end

    -- Precision High-Performance Component Card (Zero Rotated Elements for 100% Guaranteed Scroll Clipping)
    function Custom:CreateComponentCard(cfg)
        local parent = cfg.Parent
        local size = cfg.Size or UDim2.new(1, 0, 0, 36)
        local pos = cfg.Position or UDim2.new(0, 0, 0, 0)
        local anchor = cfg.AnchorPoint or Vector2.new(0, 0)
        local layoutOrder = cfg.LayoutOrder or 0
        local name = cfg.Name or "ComponentCard"
        local cornerRadius = cfg.CornerRadius or cfg.Chamfer or 6
        local strokeColor = cfg.StrokeColor or Custom.StrokeColor
        local fillColor = cfg.FillColor or Custom.CardDark
        local strokeThickness = cfg.StrokeThickness or 1
        local zIndex = cfg.ZIndex or 2
        local clips = (cfg.ClipsDescendants ~= nil) and cfg.ClipsDescendants or false

        -- Root card container (no rotated children - guarantees clean clipping inside ScrollingFrames)
        local root = Custom:Create("Frame", {
            BackgroundColor3 = fillColor,
            BackgroundTransparency = cfg.FillTransparency or 0,
            BorderSizePixel = 0,
            Size = size,
            Position = pos,
            AnchorPoint = anchor,
            LayoutOrder = layoutOrder,
            ClipsDescendants = clips,
            Name = name,
            ZIndex = zIndex
        }, parent)

        local corner = Custom:Create("UICorner", {
            CornerRadius = UDim.new(0, cornerRadius),
            Name = "CardCorner"
        }, root)

        local stroke = nil
        if strokeThickness and strokeThickness > 0 and strokeColor then
            stroke = Custom:Create("UIStroke", {
                Color = strokeColor,
                Thickness = strokeThickness,
                Transparency = cfg.StrokeTransparency or 0,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Name = "CardStroke"
            }, root)
        end

        local cardData = {
            Root = root,
            Corner = corner,
            Stroke = stroke,
            SetFillColor = function(col, dur)
                if dur and dur > 0 then
                    TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = col}):Play()
                else
                    root.BackgroundColor3 = col
                end
            end,
            SetStrokeColor = function(col, dur)
                if stroke then
                    if dur and dur > 0 then
                        TweenService:Create(stroke, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = col}):Play()
                    else
                        stroke.Color = col
                    end
                end
            end,
            SetCornerColor = function(col, dur)
                if stroke then
                    if dur and dur > 0 then
                        TweenService:Create(stroke, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = col}):Play()
                    else
                        stroke.Color = col
                    end
                end
            end,
            SetFillTransparency = function(trans, dur)
                if dur and dur > 0 then
                    TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = trans}):Play()
                else
                    root.BackgroundTransparency = trans
                end
            end,
            SetStrokeTransparency = function(trans, dur)
                if stroke then
                    if dur and dur > 0 then
                        TweenService:Create(stroke, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = trans}):Play()
                    else
                        stroke.Transparency = trans
                    end
                end
            end
        }

        root:SetAttribute("ComponentCard", true)
        return root, cardData
    end
end

-- Helper: Draggable Frame
local function MakeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragStart = nil
    local startPos = nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position

            local changedConn, endedConn
            changedConn = UserInputService.InputChanged:Connect(function(moveInput)
                if dragging and (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) then
                    local delta = moveInput.Position - dragStart
                    targetFrame.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)

            endedConn = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    if changedConn then changedConn:Disconnect() changedConn = nil end
                    if endedConn then endedConn:Disconnect() endedConn = nil end
                end
            end)
        end
    end)
end

-- Helper: Circle click / Ripple feedback (Supports Chamfer Cards & Standard Frames)
local function RippleClick(Button, cardData)
    if cardData and cardData.SetFillColor then
        cardData.SetFillColor(Color3.fromRGB(36, 46, 68), 0.08)
        task.delay(0.12, function()
            pcall(function()
                cardData.SetFillColor(Custom.CardDark, 0.15)
            end)
        end)
    else
        local orig = Button.BackgroundColor3
        TweenService:Create(Button, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {BackgroundColor3 = Color3.fromRGB(50, 40, 70)}):Play()
        task.delay(0.12, function()
            pcall(function()
                if Button and Button.Parent then
                    TweenService:Create(Button, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {BackgroundColor3 = orig}):Play()
                end
            end)
        end)
    end
end

